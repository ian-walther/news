[Unit]
Description=Share the Newspaper persistent Xorg desktop
After=display-manager.service network-online.target
Requires=display-manager.service
Wants=network-online.target

[Service]
Type=simple
Environment=FD_XDM=1
EnvironmentFile=/etc/newspaper-browser/browser-desktop.env
ExecStartPre=/usr/local/libexec/newspaper-browser/wait-for-x
ExecStart=/usr/bin/x11vnc -display ${DISPLAY} -auth guess -rfbauth /etc/newspaper-browser/x11vnc.pass -rfbport ${VNC_PORT} -listen ${VNC_LISTEN_ADDRESS} -forever -shared -repeat -noxdamage -xkb
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=graphical.target

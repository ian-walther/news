# --- News application read API (server-side only) ----------------------------
NEWS_API_URL=http://localhost:4000
# NEWS_API_TIMEOUT_MS=30000

# --- HTTP entry point ---------------------------------------------------------
# MCP_HTTP_HOST=127.0.0.1          # bind address; 0.0.0.0 inside containers
# MCP_HTTP_PORT=3940
# MCP_HTTP_PATH=/mcp
# MCP_PUBLIC_URL=https://news-mcp.example.net/mcp     # externally visible endpoint (required for oidc)
# MCP_ALLOWED_HOSTS=news-mcp.example.net              # Host header allow-list (MCP_PUBLIC_URL's host and loopback are implied)
# MCP_TRUST_PROXY=false                               # use X-Forwarded-For for rate limiting keys
# MCP_HTTP_RESPONSE_MODE=auto                         # json = never stream (use behind buffering proxies)
# MCP_RESULT_STRUCTURED=true                          # false = text-only tool results

# Auth mode: none (loopback only), static (dev tokens), oidc (production)
# MCP_AUTH_MODE=oidc
# MCP_STATIC_TOKENS=dev@some-long-random-token:news.read
# MCP_OIDC_ISSUER=https://your-tenant.us.auth0.com/
# MCP_OIDC_AUDIENCE=https://news-mcp.example.net/mcp  # defaults to MCP_PUBLIC_URL

# Limits and logging
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP_RATE_LIMIT_BURST=30
# MCP_AUDIT_LOG_PATH=/var/log/news-mcp/audit.jsonl
# LOG_LEVEL=info
